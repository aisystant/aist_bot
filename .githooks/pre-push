#!/bin/bash
# Pre-push hook: блокирует push в new-architecture без явного подтверждения.
# Правило Pilot-First: все изменения сначала на pilot, потом на прод.
# Обход: FORCE_PROD=1 git push origin new-architecture
# WP-7 peer-session 2026-06-01-44: детекция дубль-коммитов + escape-hatch.
# Примечание: FORCE_PROD=1 НЕ обходит детектор дублей — нужен [incident-ok] в commit message.

PROTECTED_BRANCH="new-architecture"
remote="$1"

while read local_ref local_sha remote_ref remote_sha; do
    if echo "$remote_ref" | grep -q "refs/heads/${PROTECTED_BRANCH}"; then

        # ─── WP-7: детекция дубль-коммитов (peer-session 2026-06-01-44) ───
        # Escape-hatch: осознанный обход при инциденте или cherry-pick
        has_escape_hatch=false
        if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
            if git log --format="%s %b" "${remote_sha}..${local_sha}" 2>/dev/null | grep -qE '\[(incident-ok|cherry-pick-ok)\]'; then
                has_escape_hatch=true
            fi
        fi

        if [ "$has_escape_hatch" = false ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && git show-ref --verify --quiet refs/heads/pilot; then
            duplicate_found=false
            while read commit_sha; do
                [ -z "$commit_sha" ] && continue
                # Пропускаем коммиты, которые уже есть на pilot (legitimate merge)
                if git branch --contains "$commit_sha" 2>/dev/null | grep -q "pilot"; then
                    continue
                fi
                should_break=false
                while IFS= read -r file; do
                    [ -z "$file" ] && continue
                    if git log pilot --since="24 hours ago" --oneline -- "$file" 2>/dev/null | grep -q .; then
                        echo ""
                        echo "⚠️  DUPLICATE WARNING: '$file' менялся на pilot за последние 24ч."
                        echo "    Возможно, этот фикс уже есть на pilot — сделай merge вместо повторной правки."
                        echo "    Если осознанный cherry-pick: добавь [cherry-pick-ok] в сообщение коммита"
                        echo "    Если hotfix инцидента: добавь [incident-ok] в сообщение коммита"
                        echo ""
                        duplicate_found=true
                        should_break=true
                        break
                    fi
                done < <(git diff-tree --no-commit-id --name-only -r "$commit_sha" 2>/dev/null)
                if [ "$should_break" = true ]; then
                    break
                fi
            done < <(git rev-list --no-merges "${remote_sha}..${local_sha}" 2>/dev/null)

            if [ "$duplicate_found" = true ]; then
                exit 1
            fi
        fi

        if [ "$FORCE_PROD" != "1" ]; then
            echo ""
            echo "⛔ PUSH BLOCKED: ветка '${PROTECTED_BRANCH}' защищена (Pilot-First)."
            echo ""
            echo "   Все изменения сначала → pilot → проверка → потом прод."
            echo "   Если уверен: FORCE_PROD=1 git push origin ${PROTECTED_BRANCH}"
            echo ""
            exit 1
        fi
        echo "⚠️  FORCE_PROD=1 — push в ${PROTECTED_BRANCH} разрешён."

        # ─── PRODSYNC2: видимость обратного разрыва (backport drift) ───
        # Принцип (пир-сессия 2026-07-09-18): backport хотфикса в pilot — критерий
        # закрытия хотфикса, не отложенный шаг. Хук не блокирует push (инцидент
        # нельзя тормозить), но громко показывает счётчик после каждого прод-пуша,
        # чтобы разрыв не рос молча неделями (см. PRODSYNC1: 24 → 43 → 105+ коммитов).
        if git show-ref --verify --quiet refs/heads/pilot; then
            drift_count=$(git cherry pilot "$local_sha" 2>/dev/null | grep -c '^+')
            if [ "$drift_count" -gt 10 ]; then
                echo ""
                echo "🔶 BACKPORT DRIFT: ${drift_count} правок на ${PROTECTED_BRANCH} отсутствуют"
                echo "    в pilot (git cherry, по содержимому патча). Порог 10 превышен."
                echo "    → Запланируй раунд синхронизации (пир-сессия DP.SC.154, по образцу"
                echo "      PRODSYNC1/PRODSYNC2), не откладывай — разрыв растёт молча."
                echo ""
            fi
        fi
    fi
done

# WP-218 Ф2: R28 Profiler calculator вынесен из бота.
# dt_calc.py больше не копируется в db/queries/ — бот его не импортирует.
# Проверка vendoring удалена (нечего проверять).

# ─── S59: Smoke тесты перед push (WP-179) ───
if [ -d ".venv" ] && [ -d "tests/smoke" ]; then
    echo "🧪 Running smoke tests..."
    .venv/bin/python -m pytest tests/smoke/ -q --tb=line 2>&1
    PYTEST_EXIT=$?
    if [ $PYTEST_EXIT -ne 0 ]; then
        echo ""
        echo "⛔ PUSH BLOCKED: smoke тесты не прошли (exit code $PYTEST_EXIT)"
        echo "   Исправьте ошибки и повторите push."
        echo ""
        exit 1
    fi
    echo "✅ Smoke тесты пройдены"
fi

exit 0
