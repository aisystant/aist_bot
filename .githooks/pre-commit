#!/bin/bash
# Pre-commit hook: warning-only напоминание про синхронизацию кода и документации.
# НЕ блокирует commit — только печатает напоминание, если diff касается областей,
# которые обычно требуют обновления docs/.
#
# Активация: git config core.hooksPath .githooks
#
# Обоснование: WP-7 DOC2 — снизить drift между кодом и документацией. Каждый раз
# когда разработчик меняет handler / core / models / миграции, pre-commit должен
# напомнить про соответствующие docs (§4.3 CLAUDE.md — таблица «Изменение кода →
# Категория документации»).

# ─── Собираем staged diff ───
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
    exit 0
fi

# ─── Флаги того, что было затронуто ───
touched_handlers=0
touched_core=0
touched_models=0
touched_migrations=0
touched_engines=0
touched_queries=0
touched_states=0
touched_dev=0
touched_admin=0

while IFS= read -r file; do
    case "$file" in
        handlers/dev.py)
            touched_dev=1
            ;;
        handlers/feedback.py|handlers/workshop.py)
            touched_admin=1
            touched_handlers=1
            ;;
        handlers/*.py)
            touched_handlers=1
            ;;
        core/*.py)
            touched_core=1
            ;;
        db/models.py)
            touched_models=1
            ;;
        db/migrations/*|db/migrations/**/*)
            touched_migrations=1
            ;;
        db/queries/*.py)
            touched_queries=1
            ;;
        engines/*.py|engines/**/*.py)
            touched_engines=1
            ;;
        states/*.py|states/**/*.py)
            touched_states=1
            ;;
    esac
done <<< "$staged_files"

# ─── WP-478: стоп-лист лексики «образования» в user-facing текстах (warning-only) ───
# Источник: WP-478 (Развитие ≠ Образование, DP.D.132/D.182).
# Проверяет только ДОБАВЛЕННЫЕ строки в user-facing файлах. Не блокирует commit:
# домен-термины (методы обучения, kids-контент) и keyword-листы роутинга — осознанные исключения.
# ВАЖНО: секция стоит ДО early-exit — i18n/schema.yaml и config/prompts не входят в code-категории.
lexicon_report=""
while IFS= read -r file; do
    case "$file" in
        i18n/schema.yaml|bot.py|handlers/*.py|core/onboarder/*.py|core/scheduler.py|core/tier_config.py|states/*.py|states/**/*.py|config/prompts/*.md|engines/feed/planner.py)
            hits=$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' | grep -iE "урок|обучени|учебн|студент|первокурсник" || true)
            if [ -n "$hits" ]; then
                lexicon_report="$lexicon_report\n  $file:\n$(echo "$hits" | head -5 | sed 's/^/    /')"
            fi
            ;;
    esac
done <<< "$staged_files"

if [ -n "$lexicon_report" ]; then
    echo ""
    echo "⚠️  WP-478 lexicon stop-list (warning-only): лексика «образования» в user-facing файлах:"
    echo -e "$lexicon_report"
    echo "   Замени: урок→занятие, обучение→развитие, студент/ученик→участник/стажёр."
    echo "   Домен-термины (методы обучения, kids-контент) и keyword-листы — проигнорируй."
    echo ""
fi

# ─── Если ничего не затронуто — выходим ───
total_touched=$((touched_handlers + touched_core + touched_models + touched_migrations + touched_engines + touched_queries + touched_states + touched_dev + touched_admin))
if [ $total_touched -eq 0 ]; then
    exit 0
fi

# ─── Проверка: были ли затронуты docs в том же commit ───
docs_touched=0
if echo "$staged_files" | grep -q "^docs/"; then
    docs_touched=1
fi

# ─── Печатаем напоминание ───
echo ""
echo "📝 Pre-commit reminder (warning-only, commit продолжится):"
echo ""

if [ $touched_handlers -eq 1 ]; then
    echo "   • handlers/*.py изменены → обнови docs/scenarios/ (§4.2-4.3 CLAUDE.md)"
    echo "     Вид A: 01-основные/, Вид B: 02-вспомогательные/, Вид C: 03-микро/"
fi

if [ $touched_states -eq 1 ]; then
    echo "   • states/*.py изменены → обнови docs/scenarios/ (обычно вид B, FSM wizard)"
fi

if [ $touched_core -eq 1 ] || [ $touched_engines -eq 1 ]; then
    echo "   • core/*.py или engines/*.py изменены → обнови docs/processes/"
fi

if [ $touched_queries -eq 1 ]; then
    echo "   • db/queries/*.py изменены → обнови docs/processes/ или docs/data/"
fi

if [ $touched_models -eq 1 ]; then
    echo "   • db/models.py изменён → обнови docs/data/tables.md и/или docs/data/metrics.md"
fi

if [ $touched_migrations -eq 1 ]; then
    echo "   • db/migrations/ изменены → обнови docs/data/tables.md (инвариант source-of-truth)"
fi

if [ $touched_dev -eq 1 ]; then
    echo "   • handlers/dev.py изменён → обнови docs/dev-commands.md"
fi

if [ $touched_admin -eq 1 ]; then
    echo "   • admin command (/reports или /community_report) изменены → обнови docs/admin-commands.md"
fi

if [ $docs_touched -eq 1 ]; then
    echo ""
    echo "   ✓ docs/ также в этом commit — хорошо."
else
    echo ""
    echo "   ⚠️  docs/ в этом commit НЕ изменены. Подумай: нужно ли обновить документацию?"
fi

# ─── WP-212: linter — INSERT INTO reminder без bot_id = BLOCK ───
# Защита от регрессии: любой INSERT в reminder без bot_id в списке колонок
# приводит к отклонению коммита (fail-fast).
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    # Ищем INSERT INTO reminder ... VALUES где нет bot_id в колонках
    # Паттерн: INSERT INTO reminder ( ... ) — bot_id должен быть в скобках
    VIOLATIONS=$(git diff --cached --diff-filter=ACMR -U0 | grep -E '^\+.*INSERT INTO reminder' | grep -v 'bot_id' || true)
    if [ -n "$VIOLATIONS" ]; then
        echo ""
        echo "❌ COMMIT BLOCKED (WP-212): INSERT INTO reminder без bot_id"
        echo "   Найдены нарушения в staged-изменениях:"
        echo "$VIOLATIONS" | sed 's/^/   /'
        echo ""
        echo "   Исправь: добавь bot_id в список колонок и VALUES."
        echo "   См. WP-212 — изоляция напоминаний по инстансам бота."
        echo ""
        exit 1
    fi
fi

# ─── Проверка drift контента марафона (warning-only) ───
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SYNC_SCRIPT="$SCRIPT_DIR/scripts/sync-marathon-content.sh"
if [[ -f "$SYNC_SCRIPT" ]]; then
    SYNC_OUT=$(bash "$SYNC_SCRIPT" --check 2>&1)
    SYNC_CODE=$?
    if [[ $SYNC_CODE -ne 0 ]]; then
        echo ""
        echo "   ⚠️  Контент марафона: расхождение SoT vs bot-копия."
        echo "      Запусти: bash scripts/sync-marathon-content.sh"
        echo "      Затем: git add data/marathon-content.json && git commit --amend --no-edit"
    fi
fi

echo ""
echo "   Это только напоминание. Commit продолжится в любом случае."
echo ""

exit 0
