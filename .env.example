# aist_bot_newarchitecture — конфигурация
# Скопировать в .env и заполнить значения. НЕ коммитить .env

# ─── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── AI / LLM ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Базы данных (Neon) ───────────────────────────────────────────────────
DATABASE_URL=
DT_DATABASE_URL=
LMS_DATABASE_URL=

# ─── Внутренние сервисы платформы ────────────────────────────────────────
PERSONA_URL=
SUBSCRIPTION_URL=
INDICATORS_URL=
LEARNING_URL=
REWARDS_URL=
CONSENT_URL=
FSM_URL=
JOURNAL_URL=
HEALTH_URL=
SECRETS_URL=
PUBLICATION_URL=
COMMUNITY_URL=
LEAD_URL=
REFERENCE_URL=

# ─── MCP-серверы ─────────────────────────────────────────────────────────
KNOWLEDGE_MCP_URL=
DIGITAL_TWIN_MCP_URL=
GATEWAY_MCP_URL=

# ─── Event Gateway ────────────────────────────────────────────────────────
EVENT_GATEWAY_URL=
EVENT_GATEWAY_TIMEOUT=10
EVENT_GATEWAY_ENABLED=true

# ─── Langfuse (трейсинг LLM) ─────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── GitHub OAuth ─────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_BOT_PAT=
AUTOFIX_REPO=
AUTOFIX_BRANCH_BASE=main

# ─── Linear OAuth ────────────────────────────────────────────────────────
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=

# ─── Google Calendar OAuth ───────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ─── WakaTime OAuth ──────────────────────────────────────────────────────
WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=
WAKATIME_REDIRECT_URI=

# ─── Ory / Auth ──────────────────────────────────────────────────────────
ORY_BASE_URL=
ORY_CLIENT_ID=
